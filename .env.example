# Copy to .env (gitignored) and fill in. NEVER commit real values.
#
# The game's TEST key (it only returns test-code data). Used by `npm run dev` / `preview`.
# NEVER put the LIVE key here: the live key lives only in the server's nginx proxy (README → Deploy).
# Without VITE_THEOSWAP_PROXY, Vite inlines this key into the JavaScript players download.
# Without a key, the Connect screen still works with the bundled demo profiles.
VITE_THEOSWAP_API_KEY=

# Optional: point at another TheoSwap host (e.g. a local dev server).
VITE_THEOSWAP_URL=https://www.theoswap.io

# Live builds: call our own server's proxy instead (no key in the bundle). Put this line in
# .env.production (gitignored) so it applies to `npm run build` / `npm run deploy` only:
# VITE_THEOSWAP_PROXY=./api/user-items

# Optional: where `npm run deploy` uploads dist/ with rsync (user@host:/folder/).
DEPLOY_TARGET=
