# Copy to .env (gitignored) and fill in. NEVER commit real values.
#
# The game calls TheoSwap's GET /api/public/user-items directly from the browser (the
# developer's choice for now, instead of a proxy). Vite inlines every VITE_* variable into
# the JavaScript sent to players, so this key IS visible in the built game:
#   • use the game's TEST key (it only returns test-code data) for demos and dev;
#   • before shipping the LIVE key, put a proxy in front (see PLAN.md, milestone 2).
# Without a key, the Connect screen still works with the bundled demo profiles.
VITE_THEOSWAP_API_KEY=

# Optional: point at another TheoSwap host (e.g. a local dev server).
VITE_THEOSWAP_URL=https://www.theoswap.io

# Optional: where `npm run deploy` uploads dist/ with rsync (user@host:/folder/).
DEPLOY_TARGET=
