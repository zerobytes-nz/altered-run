# Copy to .env (gitignored) and fill in. NEVER commit real values.
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript sent to players' browsers.
# So the TheoSwap API key must NOT be a VITE_ variable. It lives only in the small proxy
# (milestone 2) that calls TheoSwap on the game's behalf. `npm run check-assets` rejects
# VITE_*KEY / *SECRET / *TOKEN names.

# ── Browser-safe (bundled into the game) ────────────────────────────────────
# URL of the proxy that wraps GET /api/public/user-items (it adds the apiKey server-side).
VITE_AWI_PROXY_URL=

# ── Server-only (used by the proxy, never by the game bundle) ───────────────
# TheoSwap developer API key for this game. Use the TEST key for demos.
THEOSWAP_API_KEY=
THEOSWAP_BASE_URL=https://www.theoswap.io
